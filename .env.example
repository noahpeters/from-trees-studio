# Table-shape feature flags. Rectangle is enabled by default; circle and oval
# remain hidden while their artwork is being refined.
NEXT_PUBLIC_FEATURE_TABLE_SHAPE_RECTANGLE=true
NEXT_PUBLIC_FEATURE_TABLE_SHAPE_CIRCLE=false
NEXT_PUBLIC_FEATURE_TABLE_SHAPE_OVAL=false

# Per-request preview overrides accept a flag name, comma-separated names, or
# repeated parameters. Explicit disables win over enables:
# /configurator?rectangle--white-oak--84--42--soft-square--curved-slab--none&env_enable=oval
# /configurator?oval--white-oak--84--42--soft-square--curved-slab--none&env_enable=oval&env_disable=circle
